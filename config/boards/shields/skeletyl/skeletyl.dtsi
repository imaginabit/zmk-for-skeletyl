/*
 * DIAGNÓSTICO v3 — mapeo pro_micro corregido
 *
 * gpio-map oficial nice_nano v2 (de /connector):
 *   pro_micro  0 = P0.08 (RX)
 *   pro_micro  1 = P0.06 (TX)
 *   pro_micro  2 = P0.17 (SCK)
 *   pro_micro  3 = P0.20 (MISO)
 *   pro_micro  4 = P0.22 (MOSI)
 *   pro_micro  5 = P0.24 (CS)
 *   pro_micro  6 = P1.00 (SDA)
 *   pro_micro  7 = P0.11 (SCL)
 *   pro_micro  8 = P1.04
 *   pro_micro  9 = P1.06
 *   pro_micro 10 = P0.09 (NFC1)
 *   pro_micro 14 = P1.11
 *   pro_micro 15 = P1.13 (SDA1)
 *   pro_micro 16 = P0.10 (NFC2)
 *   pro_micro 18 = P1.15 (SCL1)
 *   pro_micro 19 = P0.02 (A1)
 *   pro_micro 20 = P0.29 (A2)
 *   pro_micro 21 = P0.31 (A3)
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {

	chosen {
		zmk,kscan = &kscan0;
		zmk,matrix_transform = &default_transform;
	};

	default_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		columns = <1>;
		rows    = <8>;
		map = <
			RC(0,0)
			RC(1,0)
			RC(2,0)
			RC(3,0)
			RC(4,0)
			RC(5,0)
			RC(6,0)
			RC(7,0)
		>;
	};

	kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN_TEST3";
        wakeup-source;
        diode-direction = "row2col";

        // 8 GPIOs candidatos para R1 (F7), col = P0.29
        row-gpios
            = <&pro_micro 18 (GPIO_ACTIVE_HIGH)>      // 0  P1.15 (D14/SCL1)  → Q
            , <&pro_micro 19 (GPIO_ACTIVE_HIGH)>      // 1  P0.02 (D19/A1)    → W   [R1 actual]
            , <&pro_micro 21 (GPIO_ACTIVE_HIGH)>      // 2  P0.31 (D21/A3)    → E
            , <&pro_micro  1 (GPIO_ACTIVE_HIGH)>      // 3  P0.06 (D1/RX)     → R
            , <&pro_micro  2 (GPIO_ACTIVE_HIGH)>      // 4  P0.17 (D2/SCK)    → T
            , <&pro_micro 15 (GPIO_ACTIVE_HIGH)>      // 5  P1.13 (D13/SDA1)  → Y
            , <&pro_micro 14 (GPIO_ACTIVE_HIGH)>      // 6  P1.11 (D12)       → U
            , <&pro_micro 16 (GPIO_ACTIVE_HIGH)>      // 7  P0.10 (D11/NFC2)  → I
            ;
    };

};
