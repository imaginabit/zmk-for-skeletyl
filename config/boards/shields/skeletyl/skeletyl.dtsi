#include <dt-bindings/zmk/matrix_transform.h>

/ {

	chosen {
		zmk,kscan = &kscan0;
		zmk,matrix_transform = &default_transform;
	};

	default_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		columns = <10>;
		rows    = <4>;
		// thumbs en fila 3 (cols 0, 2, 3 = F5, D7, E6)
		map = <
		 RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)   RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
		 RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)   RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
		 RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)   RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
		             RC(3,2) RC(3,3) RC(3,0)        RC(3,9) RC(3,6) RC(3,7)
		>;
	};

	 kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";

        diode-direction = "row2col";

        // 4 filas físicas cableadas (orden firmware R0..R3):
        //   R0 = P1.15 (pro_micro 14)  → F7 (q w e r t)   [cable movido de P0.02 a P1.15]
        //   R1 = P0.22 (pro_micro  4)  → D4 (a s d f g)   [C6/D4 invertidos vs QMK]
        //   R2 = P0.24 (pro_micro  5)  → C6 (z x c v b)
        //   R3 = P1.06 (pro_micro  9)  → B5 (thumbs)
        row-gpios
            = <&pro_micro 14 (GPIO_ACTIVE_HIGH)>
            , <&pro_micro  4 (GPIO_ACTIVE_HIGH)>
            , <&pro_micro  5 (GPIO_ACTIVE_HIGH)>
            , <&pro_micro  9 (GPIO_ACTIVE_HIGH)>
            ;
    };

};
