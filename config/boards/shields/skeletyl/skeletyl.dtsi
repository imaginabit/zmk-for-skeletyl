/*
 * DIAGNÓSTICO — fila única, muchas filas alternativas
 *
 * keymap:
 *   col 0 (P0.29) + row 0 (P1.15)  → Q
 *   col 0 (P0.29) + row 1 (P0.31)  → W
 *   col 0 (P0.29) + row 2 (P0.06)  → E
 *   col 0 (P0.29) + row 3 (P1.00)  → R
 *
 * Puentear P0.29 con cada uno de esos pines y ver qué letra sale.
 * Si NO sale ninguna letra → el problema está en el pin P0.29 o el driver.
 * Si salen algunas → sabemos qué pines están vivos.
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {

	chosen {
		zmk,kscan = &kscan0;
		zmk,matrix_transform = &default_transform;
	};

	default_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		columns = <1>;
		rows    = <4>;
		map = <
			RC(0,0)
			RC(1,0)
			RC(2,0)
			RC(3,0)
		>;
	};

	kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN_TEST";
        wakeup-source;
        diode-direction = "row2col";

        // 4 filas alternativas, todas probando con la misma col P0.29 (C1)
        row-gpios
            = <&pro_micro 14 (GPIO_ACTIVE_HIGH)>      // P1.15 → Q  (D14 / SCL1)
            , <&pro_micro 21 (GPIO_ACTIVE_HIGH)>     // P0.31 → W  (D21 / A3)
            , <&pro_micro  0 (GPIO_ACTIVE_HIGH)>     // P0.06 → E  (D0  / TX)
            , <&pro_micro  6 (GPIO_ACTIVE_HIGH)>     // P1.00 → R  (D6  / SDA)
            ;
    };

};
