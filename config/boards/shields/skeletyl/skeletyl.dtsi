/*
 * DIAGNÓSTICO — 8 filas alternativas, 1 sola col
 *
 * Cada fila se asigna a una letra. Puentear P0.29 (F5) con cada
 * pin y ver qué letra sale.
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {

	chosen {
		zmk,kscan = &kscan0;
		zmk,matrix_transform = &default_transform;
	};

	default_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		columns = <1>;
		rows    = <8>;
		map = <
			RC(0,0)
			RC(1,0)
			RC(2,0)
			RC(3,0)
			RC(4,0)
			RC(5,0)
			RC(6,0)
			RC(7,0)
		>;
	};

	kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN_TEST2";
        wakeup-source;
        diode-direction = "row2col";

        // 8 GPIOs que NO son USB ni power ni debug.
        // [test1: P1.15=NO, P0.31=NO, P0.06=NO, P1.00=SÍ]
        row-gpios
            = <&pro_micro 14 (GPIO_ACTIVE_HIGH)>      // 0  P1.15 (D14/SCL1)  → Q   [test1: NO]
            , <&pro_micro 21 (GPIO_ACTIVE_HIGH)>     // 1  P0.31 (D21/A3)    → W   [test1: NO]
            , <&pro_micro  2 (GPIO_ACTIVE_HIGH)>     // 2  P0.17 (D2/SCK)    → E   [nuevo]
            , <&pro_micro  3 (GPIO_ACTIVE_HIGH)>     // 3  P0.20 (D3/MISO)   → R   [nuevo]
            , <&pro_micro 13 (GPIO_ACTIVE_HIGH)>     // 4  P1.13 (D13/SDA1)  → T   [nuevo]
            , <&pro_micro 11 (GPIO_ACTIVE_HIGH)>     // 5  P0.10 (D11/NFC2)  → Y   [nuevo]
            , <&pro_micro 12 (GPIO_ACTIVE_HIGH)>     // 6  P1.11 (D12)       → U   [nuevo]
            , <&pro_micro  6 (GPIO_ACTIVE_HIGH)>     // 7  P1.00 (D6/SDA)    → I   [test1: SÍ, control]
            ;
    };

};
