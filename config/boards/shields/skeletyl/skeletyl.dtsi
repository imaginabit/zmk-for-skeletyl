#include <dt-bindings/zmk/matrix_transform.h>

/ {

	chosen {
		zmk,kscan = &kscan0;
		zmk,matrix_transform = &default_transform;
	};

	default_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		columns = <10>;
		rows    = <4>;
		// thumbs en fila 3 (cols 0, 2, 3 = F5, D7, E6)
		map = <
		 RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)   RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
		 RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)   RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
		 RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)   RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
		             RC(3,2) RC(3,3) RC(3,0)        RC(3,9) RC(3,6) RC(3,7)
		>;
	};

	 kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        wakeup-source;
        diode-direction = "row2col";

        // Pines verificados funcional en este nice_nano v2.
        //
        // Filas (4):
        //   R0 F7  = P1.11 (D12)        ← cable movido aquí desde P0.02 (muerto)
        //   R1 C6  = P0.24 (D5/CS)
        //   R2 D4  = P0.22 (D4/MOSI)    [C6/D4 invertidos vs QMK upstream]
        //   R3 B5  = P1.06 (D9)         [thumb cluster]
        //
        // Cols (5):
        //   C1 F5  = P0.29 (A2/D20)
        //   C2 B6  = P0.09 (D10/NFC1)
        //   C3 D7  = P1.00 (D6/SDA)
        //   C4 E6  = P0.11 (D7/SCL)
        //   C5 B4  = P1.04 (D8)
        //
        // Pines MUERTOS en este MCU (no usar): P0.02, P0.31, P1.15, P1.13.
        row-gpios
            = <&pro_micro 14 (GPIO_ACTIVE_HIGH)>      // R0 F7 = P1.11 (D12)
            , <&pro_micro  4 (GPIO_ACTIVE_HIGH)>      // R1 C6 = P0.22 (D4/MOSI)  [fila asdfg física]
            , <&pro_micro  5 (GPIO_ACTIVE_HIGH)>      // R2 D4 = P0.24 (D5/CS)    [fila zxcvb física]
            , <&pro_micro  9 (GPIO_ACTIVE_HIGH)>      // R3 B5 = P1.06 (D9)
            ;
    };

};
